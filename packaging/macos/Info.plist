<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Hello CSV</string>
  <key>CFBundleDisplayName</key><string>Hello CSV</string>
  <key>CFBundleIdentifier</key><string>io.github.hellocsv</string>
  <key>CFBundleExecutable</key><string>hellocsv</string>
  <key>CFBundleIconFile</key><string>hellocsv</string>
